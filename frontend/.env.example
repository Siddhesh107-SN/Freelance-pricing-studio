# =============================================================================
# Freelance Pricing Studio - Frontend Environment Configuration
# Copy this file to .env inside the frontend/ folder if customization is needed.
# =============================================================================

# Base URL for API requests.
# Leave empty in development: Vite dev proxy routes /api and /uploads to http://localhost:8000
# In production, set to your backend API domain (e.g., https://api.yourdomain.com/api)
VITE_API_URL=
