# =============================================================================
# Freelance Pricing Studio - Root Environment Template
# Copy this file to .env (or configure backend/.env directly).
# NEVER commit your actual .env file or credentials to source control.
# =============================================================================

# --- Backend Database ---
# SQLite (Quick local development):
DATABASE_URL=sqlite:///./freelance.db
# MySQL 8 (Production / Codespaces / Docker):
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost:3306/freelance_pricing?charset=utf8mb4

# --- Backend Security & Authentication ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=480

# --- Backend Server Configuration ---
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=uploads

# --- Initial Seed Accounts (Used by `python -m app.seed`) ---
SEED_USER1_NAME=Developer One
SEED_USER1_EMAIL=dev1@example.com
SEED_USER1_PASSWORD=change-me-to-at-least-10-chars

SEED_USER2_NAME=Developer Two
SEED_USER2_EMAIL=dev2@example.com
SEED_USER2_PASSWORD=change-me-to-at-least-10-chars

# --- Business Profile Defaults (Optional overrides for seed) ---
SEED_BUSINESS_NAME=Logic Loops
SEED_BUSINESS_TAGLINE=Software Architecture & Design Studio
SEED_BUSINESS_BRAND_COLOR=#111827
SEED_BUSINESS_UPI_ID=yourname@upi
SEED_BUSINESS_GSTIN=27AAAAA0000A1Z5

# --- Frontend Configuration (Set in frontend/.env if customizing) ---
# Leave empty for Vite local proxy (/api -> http://localhost:8000)
# VITE_API_URL=
