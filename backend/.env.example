# =============================================================================
# Freelance Pricing Studio - Backend Environment Configuration
# Copy this file to .env inside the backend/ folder and configure your values.
# NEVER commit .env to version control.
# =============================================================================

# Database Connection:
# For MySQL 8 (Production / Docker / Codespaces):
DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost:3306/freelance_pricing?charset=utf8mb4
# For SQLite (Quick local development):
# DATABASE_URL=sqlite:///./freelance.db

# JWT Authentication (use a secure random string of 32+ characters)
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=480

# CORS Allowed Origins (comma-separated list for frontend clients)
CORS_ORIGINS=http://localhost:5173

# Directory for file uploads (relative to backend working directory)
UPLOAD_DIR=uploads

# --- Initial Seed Accounts (Used only by `python -m app.seed`) ---
SEED_USER1_NAME=Developer One
SEED_USER1_EMAIL=dev1@example.com
SEED_USER1_PASSWORD=change-me-to-at-least-10-chars

SEED_USER2_NAME=Developer Two
SEED_USER2_EMAIL=dev2@example.com
SEED_USER2_PASSWORD=change-me-to-at-least-10-chars

# --- Default Business Settings (Optional overrides for `python -m app.seed`) ---
SEED_BUSINESS_NAME=Logic Loops
SEED_BUSINESS_TAGLINE=Software Architecture & Design Studio
SEED_BUSINESS_BRAND_COLOR=#111827
SEED_BUSINESS_UPI_ID=yourname@upi
SEED_BUSINESS_GSTIN=27AAAAA0000A1Z5
